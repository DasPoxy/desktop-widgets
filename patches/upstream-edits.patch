+
+  // Shared by the action Process below AND the file watcher, so an external
+  // writer (anything that calls notes_manager.py directly, bypassing this
+  // widget's own UI/IPC — e.g. Claude posting a task/conclusion) shows up
+  // here live instead of only after this widget next reloads from scratch.
+  function applyNotesData(res) {
+    if (res.todos !== undefined) notesWidgetRoot.todosList = res.todos
+    if (res.scratchpad !== undefined) {
+      notesWidgetRoot.scratchpadText = res.scratchpad
+      if (scratchpadEdit.text !== res.scratchpad && !scratchpadEdit.activeFocus) {
+        scratchpadEdit.text = res.scratchpad
+      }
+    }
+    if (res.commands !== undefined) notesWidgetRoot.commandsList = res.commands
+  }
+
+  FileView {
+    id: notesFileWatcher
+    path: notesWidgetRoot.notesStateFile
+    watchChanges: true
+    printErrors: false
+    onFileChanged: reload()
+    onLoaded: {
+      try {
+        notesWidgetRoot.applyNotesData(JSON.parse(text()))
+      } catch (e) {}
+    }
+  }
 
